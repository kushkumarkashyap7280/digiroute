MONGODB_URI=mongodb://127.0.0.1:27017/digiroute?directConnection=true
SESSION_SECRET=change-me-in-production-must-be-32-chars-min!!

# Cloudinary — add your credentials here when ready
# Get them from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps — optional API key (embed works out-of-the-box even without a key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── One-time super-admin setup (LOCAL .env.local ONLY — never set this on Vercel) ──
# Add a long random value (openssl rand -base64 32), run `npm run dev`, open
# http://localhost:3000/dev/setup-admin, then DELETE this line again.
# SUPER_ADMIN_BOOTSTRAP_TOKEN=
